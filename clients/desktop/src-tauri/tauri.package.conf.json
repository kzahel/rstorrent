{
  "build": {
    "beforeBuildCommand": "node ../../scripts/prepare-native-host.mjs --release && npm --prefix ../web run build && node ../../scripts/prepare-release-notices.mjs",
    "beforeBundleCommand": "node ../../scripts/prepare-appimage-notices.mjs"
  },
  "bundle": {
    "externalBin": [
      "binaries/rstorrent-native-host"
    ],
    "resources": {
      "binaries/notices/": "notices/"
    },
    "useLocalToolsDir": true
  }
}
