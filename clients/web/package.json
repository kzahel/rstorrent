{
  "name": "rstorrent-web",
  "version": "0.1.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prebuild": "npm run generate:validators",
    "build": "vite build && npm run check:csp",
    "check:csp": "node scripts/check-csp-safe-dist.mjs",
    "predev": "npm run generate:validators",
    "dev": "vite",
    "generate": "npm run generate:contract && npm run generate:validators",
    "generate:contract": "cargo run -p rstorrent-gateway --bin export_types -- src/api/generated/v1.ts src/api/generated/v1.schema.json src/fixtures/reactive-trace.json src/fixtures/view-set-trace.json",
    "generate:validators": "node scripts/generate-validators.mjs",
    "pretest": "npm run generate:validators",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "pretypecheck": "npm run generate:validators",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-updater": "2.10.1",
    "react": "19.2.8",
    "react-aria-components": "1.20.0",
    "react-dom": "19.2.8",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/ws": "8.18.1",
    "ajv": "8.20.0",
    "jsdom": "29.1.1",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "ws": "8.21.1"
  }
}
