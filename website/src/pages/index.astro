---
import '../styles/global.css'

const title = 'RSTorrent — Coming soon'
const description =
  'A new open-source torrent client from the creator of JSTorrent, built around a first-party Rust engine.'
const canonicalUrl = new URL(Astro.url.pathname, Astro.site)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0a1014" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="RSTorrent" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <title>{title}</title>
  </head>
  <body>
    <main>
      <section class="hero" aria-labelledby="title">
        <div class="brand-mark" aria-hidden="true">
          <span>RS</span>
          <i></i>
          <i></i>
          <i></i>
        </div>

        <div class="copy">
          <p class="status"><span></span> In active development</p>
          <h1 id="title">RSTorrent</h1>
          <p class="lead">A new torrent client from the creator of JSTorrent.</p>
          <p class="description">
            A first-party Rust engine underneath, a web-native interface on top,
            and a new cross-platform client taking shape in the open.
          </p>

          <a class="github-link" href="https://github.com/kzahel/rstorrent">
            Follow development on GitHub
            <span aria-hidden="true">↗</span>
          </a>

          <p class="availability">Coming soon. There is no public release yet.</p>
        </div>
      </section>
    </main>

    <footer>
      <p>
        From <a href="https://jstorrent.com/">JSTorrent</a> creator Kyle Graehl.
        Open source under the MIT License.
      </p>
    </footer>
  </body>
</html>
